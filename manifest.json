{
  "manifest_version": 3,
  "name": "Recipe Master",
  "description": "Finds the recipe, removes page clutter, and provides a clean recipe reader across recipe sites.",
  "version": "0.1.0",
  "minimum_chrome_version": "102",
  "browser_specific_settings": {
    "gecko": {
      "id": "recipe-master@dadxisxbored.github",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    },
    "safari": {
      "strict_min_version": "15.4"
    }
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_title": "Recipe Master",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/recipe-parser.js",
        "src/content/site-rules.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ]
}
